# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# REQUIRED for AI scoring (optional overall — the app falls back to a local
# heuristic engine if unset).
#
# IMPORTANT:
#  - The `VITE_` prefix is required. Vite only inlines `VITE_*` variables into
#    the browser bundle, and the Gemini call is made from the client.
#  - That means this key is exposed in cleartext in the built JS. Acceptable
#    for local, single-user use only. Move the call server-side before deploying.
#
# Get a key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Unused. Present for convenience only — see README "Environment Variables".
# The browser cannot read this (the process.env fallback is guarded by
# `typeof process !== 'undefined'`), and the Express server never reads it.
# GEMINI_API_KEY=your_gemini_api_key_here

# Backend port for `npm run server`. Defaults to 3001.
# If you change this, also update API_BASE in src/services/api.ts.
PORT=3001
